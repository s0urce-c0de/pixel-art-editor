module(name = "pixel-art-editor")

bazel_dep(name = "rules_closure", version = "0.17.0")

bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "rules_jvm_external", version = "7.2")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")

maven.artifact(
    group = "com.google.guava",
    artifact = "guava",
    version = "33.2.1-jre",
)

maven.artifact(
    group = "com.google.closure-stylesheets",
    artifact = "closure-stylesheets",
    version = "1.5.0",
)

maven.install(
    name = "maven",
    artifacts = [],
)
use_repo(maven, "maven")